# Copier en .env (jamais versionné) puis remplir. Mots de passe : lettres et chiffres seulement.
DOMAINE=exemple.ml
EMAIL_ADMIN=admin@exemple.ml
WHATSAPP=22376000000

# Devis et factures de Bibou : adresse et téléphone de la boutique, puis RCCM, NIF et régime
# fiscal (à faire valider par le comptable avant d'envoyer le premier devis).
BOUTIQUE_COORDONNEES="Quartier, rue, porte – Bamako
+223 76 00 00 00"
BOUTIQUE_MENTIONS_LEGALES="RCCM … – NIF …"

# SMS aux clients : « journal » (rien n'est envoyé, pour les essais) ou « orange » (API SMS
# d'Orange Developer : identifiants de l'application et numéro expéditeur du contrat).
BOUTIQUE_SMS_FOURNISSEUR=journal
BOUTIQUE_SMS_EXPEDITEUR=+22300000000
BOUTIQUE_SMS_NOM_EXPEDITEUR=Bibou
BOUTIQUE_ORANGE_CLIENT_ID=
BOUTIQUE_ORANGE_CLIENT_SECRET=

POSTGRES_PASSWORD=a-changer
COMPTES_DB_MOT_DE_PASSE=a-changer
BOUTIQUE_DB_MOT_DE_PASSE=a-changer

# Générer avec : uv run python -m comptes.outils generer-cles
# La clé privée ne doit jamais quitter le serveur.
COMPTES_JWT_CLE_PRIVEE="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
BOUTIQUE_JWT_CLE_PUBLIQUE="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
