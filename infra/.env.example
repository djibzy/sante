# Copier en .env (jamais versionné) puis remplir. Mots de passe : lettres et chiffres seulement.
DOMAINE=exemple.ml
EMAIL_ADMIN=admin@exemple.ml
WHATSAPP=22376000000
# Pages « Conditions de vente », « Confidentialité », « Mentions légales » : compléter les
# crochets dans web/boutique/app/pages/, faire valider par un juriste, puis mettre « true ».
TEXTES_JURIDIQUES_VALIDES=

# Devis et factures de Bibou : adresse et téléphone de la boutique, puis RCCM, NIF et régime
# fiscal (à faire valider par le comptable avant d'envoyer le premier devis).
BOUTIQUE_COORDONNEES="Quartier, rue, porte – Bamako
+223 76 00 00 00"
BOUTIQUE_MENTIONS_LEGALES="RCCM … – NIF …"

# SMS aux clients (suivi des commandes, codes « mot de passe oublié ») : « journal » (rien
# n'est envoyé, pour les essais) ou « orange » (API SMS d'Orange Developer : identifiants de
# l'application et numéro expéditeur du contrat). Un seul compte pour tous les services.
SMS_FOURNISSEUR=journal
SMS_EXPEDITEUR=+22300000000
SMS_NOM_EXPEDITEUR=Bibou
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=

# Téléphones de l'équipe prévenus par SMS de chaque commande ou demande de devis (liste JSON).
BOUTIQUE_TELEPHONES_EQUIPE='["76 00 00 00"]'

# Paiement mobile en ligne (Orange Money, Moov Money) : « aucun » tant que le compte marchand
# CinetPay n'est pas ouvert (le client paie à la livraison), puis « cinetpay » avec l'APIKEY et
# le site_id du tableau de bord CinetPay. L'adresse de notification, envoyée à CinetPay avec
# chaque paiement, est https://boutique.<DOMAINE>/api/v1/paiements/cinetpay/notification
BOUTIQUE_PAIEMENT_MOBILE=aucun
BOUTIQUE_CINETPAY_APIKEY=
BOUTIQUE_CINETPAY_SITE_ID=

POSTGRES_PASSWORD=a-changer
COMPTES_DB_MOT_DE_PASSE=a-changer
BOUTIQUE_DB_MOT_DE_PASSE=a-changer

# Générer avec : uv run python -m comptes.outils generer-cles
# La clé privée ne doit jamais quitter le serveur.
COMPTES_JWT_CLE_PRIVEE="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
BOUTIQUE_JWT_CLE_PUBLIQUE="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
